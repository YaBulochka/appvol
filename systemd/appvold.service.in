[Unit]
Description=appvol daemon (volume of the audio streams of the focused window)
Documentation=https://github.com/example/appvol
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Absolute path to the daemon: systemd does not read the user's PATH, and the
# path differs between a checkout, install.sh and the pacman package.
# install.sh and the PKGBUILD substitute @APPVOLD@ when they install the unit;
# see docs/development.md.
ExecStart=@APPVOLD@
# Without this, stdout/stderr are block-buffered when journald captures them and
# the log arrives in bursts.
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
