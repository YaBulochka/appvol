[Desktop Entry]
Type=Application
Name=appvol
GenericName=Application Volume Profiles
Comment=Volume profiles for the audio streams of an application
Exec=@APPVOL_GUI@
Icon=appvol
Terminal=false
StartupNotify=true
StartupWMClass=appvol
Categories=AudioVideo;Audio;
Keywords=volume;audio;pipewire;profile;stream;

# No X-KDE-Shortcuts here: this file launches the window.  The volume keys, the
# profile keys and the rest belong to the running daemon, which registers them as
# the KGlobalAccel component "Appvol".
