#!/usr/bin/env bash
# Build the release: archive, checksum, and the packages.
#
#   bin/appvol-release              # dist/appvol-<version>.tar.gz + .sha256
#   bin/appvol-release --package    # ... and the split pacman packages
#   bin/appvol-release --deb --rpm  # ... and the .deb and .rpm packages (fpm)
#   bin/appvol-release --allow-dirty
#
# The version comes from appvol/__init__.py, and packaging/PKGBUILD is kept in
# sync with it.  In a git checkout the archive is built with `git archive HEAD`,
# so only tracked files reach the release.
set -euo pipefail

self="$(readlink -f "${BASH_SOURCE[0]}")"
root="$(dirname "$self")/.."
cd "$root"

with_package=no
with_deb=no
with_rpm=no
allow_dirty=no
while [ $# -gt 0 ]; do
    case "$1" in
        --package) with_package=yes ;;
        --deb)     with_deb=yes ;;
        --rpm)     with_rpm=yes ;;
        --allow-dirty) allow_dirty=yes ;;
        -h|--help)
            sed -n '2,11p' "$self" | sed 's/^# \{0,1\}//'
            echo
            echo "Options: --package  --deb  --rpm  --allow-dirty"
            exit 0
            ;;
        *)
            echo "appvol-release: unknown option: $1" >&2
            exit 2
            ;;
    esac
    shift
done

version="$(sed -n 's/^__version__ = "\(.*\)"$/\1/p' appvol/__init__.py)"
if [ -z "$version" ]; then
    echo "appvol-release: cannot read the version from appvol/__init__.py" >&2
    exit 1
fi

archive="appvol-$version.tar.gz"
mkdir -p dist

if [ -d .git ]; then
    if [ "$allow_dirty" = no ] && [ -n "$(git status --porcelain)" ]; then
        echo "appvol-release: the working tree is dirty; commit first or pass --allow-dirty" >&2
        git status --short >&2
        exit 1
    fi
    git archive --format=tar.gz --prefix="appvol-$version/" -o "dist/$archive" HEAD
else
    echo "appvol-release: not a git checkout, archiving the working tree"
    tar --exclude=./.git --exclude=./dist --exclude='./packaging/*.tar.gz' \
        --exclude='./packaging/*.sha256' --exclude='./packaging/*.pkg.tar.*' \
        --exclude=__pycache__ --exclude='*.pyc' \
        --transform "s|^\./|appvol-$version/|" -czf "dist/$archive" .
fi

for required in \
    "appvol-$version/appvol/__init__.py" \
    "appvol-$version/appvol/gui/qml/Main.qml" \
    "appvol-$version/kwin/appvol.js" \
    "appvol-$version/desktop/org.appvol.gui.desktop.in" \
    "appvol-$version/desktop/appvol.svg" \
    "appvol-$version/systemd/appvold.service.in" \
    "appvol-$version/install.sh" \
    "appvol-$version/packaging/PKGBUILD" \
    "appvol-$version/README.md" \
    "appvol-$version/docs/architecture.md" \
    "appvol-$version/LICENSE"; do
    if ! tar tzf "dist/$archive" "$required" >/dev/null 2>&1; then
        echo "appvol-release: $required is missing from the archive" >&2
        exit 1
    fi
done

sum="$(sha256sum "dist/$archive" | cut -d' ' -f1)"
printf '%s  %s\n' "$sum" "$archive" >"dist/$archive.sha256"

# The package is built from this very archive, so makepkg finds it next to the
# PKGBUILD.  Its checksum lives in the .sha256 file: the archive contains the
# PKGBUILD itself, so no sum inside it could match.
cp "dist/$archive" "packaging/$archive"
cp "dist/$archive.sha256" "packaging/$archive.sha256"

pkgbuild=packaging/PKGBUILD
if ! grep -q "^pkgver=$version$" "$pkgbuild"; then
    sed -i "s|^pkgver=.*|pkgver=$version|" "$pkgbuild"
    sed -i "s|^pkgrel=.*|pkgrel=1|" "$pkgbuild"
    echo "appvol-release: $pkgbuild set to $version-1"
fi

built=""
if [ "$with_package" = yes ]; then
    if ! command -v makepkg >/dev/null 2>&1; then
        echo "appvol-release: --package needs makepkg (pacman-contrib)" >&2
        exit 1
    fi
    ( cd packaging && makepkg --force --cleanbuild --clean --noconfirm )
    # The PKGBUILD is a split package: appvol and appvol-gui.  The pattern allows
    # a suffix between the name and the version, as in appvol-gui-<version>-...
    for file in packaging/appvol-*"$version"*.pkg.tar.*; do
        if [ ! -f "$file" ]; then
            echo "appvol-release: makepkg produced no package to copy" >&2
            exit 1
        fi
        cp "$file" dist/
        built="$built
        dist/$(basename "$file")"
        echo "appvol-release: package built: dist/$(basename "$file")"
    done
fi

# .deb and .rpm need fpm, which builds both formats in one go.  The packages
# mirror the pacman split: appvol carries the daemon and the CLI, appvol-gui the
# window and the tray icon, so a machine without Qt stays small.
#
# The project lands in /opt/appvol and the launchers, the unit and the desktop
# entry point into it with absolute paths: systemd and kglobalacceld do not read
# the user's PATH, and a plain /opt install sidesteps the per-distribution
# site-packages layout (Debian has dist-packages, Fedora python3.X).
#
# The dependency names are the Debian/Ubuntu and Fedora ones, verified against
# both trees (Debian 13, Fedora 44): Debian and Ubuntu split PySide6 per module
# and ship Kirigami, the desktop style and Breeze as QML packages, Fedora ships
# PySide6 whole and prefixes the KF6 packages with kf6-.  The Plasma 6 floor for
# the .deb is spelled "4:6~": Debian numbers plasma-workspace with epoch 4, so a
# bare "(>= 6)" would compare 4 against 0 and let even Plasma 5 through.
url="https://github.com/YaBulochka/appvol"
maintainer="appvol contributors <noreply@github.com>"
description="Volume control for the audio streams of the focused window (KDE Plasma 6 on Wayland)"

# Both trees come from the release archive, so only tracked files reach a package
# and what is installed matches the tarball exactly.
_src="dist/.appvol-src"

prep_src() {
    rm -rf "$_src"
    mkdir -p "$_src"
    tar -xzf "dist/$archive" -C "$_src" --strip-components=1
    # Source-only paths: the tests, the packaging recipes and the demo GIF add
    # nothing to an installed tree.
    rm -rf "$_src/tests" "$_src/packaging" "$_src/docs/images" "$_src/.gitignore"
    find "$_src" -name __pycache__ -type d -prune -exec rm -rf {} +
}

# The KWin script stays next to the module: the daemon finds it there before it
# looks in the data directories.
_stage_core() {
    local root="$1"
    rm -rf "$root"
    mkdir -p "$root/opt" "$root/usr/bin" "$root/usr/lib/systemd/user"
    cp -r "$_src" "$root/opt/appvol"
    rm -rf "$root/opt/appvol/appvol/gui" "$root/opt/appvol/bin/appvol-gui"
    rm -f "$root/opt/appvol/bin/appvol-release"
    sed 's|@APPVOLD@|/opt/appvol/bin/appvold|' \
        "$root/opt/appvol/systemd/appvold.service.in" \
        >"$root/usr/lib/systemd/user/appvold.service"
    ln -sf /opt/appvol/bin/appvol  "$root/usr/bin/appvol"
    ln -sf /opt/appvol/bin/appvold "$root/usr/bin/appvold"
}

_stage_gui() {
    local root="$1"
    rm -rf "$root"
    mkdir -p "$root/opt/appvol/appvol" "$root/opt/appvol/bin" \
        "$root/usr/bin" "$root/usr/share/applications" \
        "$root/usr/share/icons/hicolor/scalable/apps"
    cp -r "$_src/appvol/gui" "$root/opt/appvol/appvol/gui"
    cp "$_src/bin/appvol-gui" "$root/opt/appvol/bin/appvol-gui"
    sed 's|@APPVOL_GUI@|/opt/appvol/bin/appvol-gui|g' \
        "$_src/desktop/org.appvol.gui.desktop.in" \
        >"$root/usr/share/applications/org.appvol.gui.desktop"
    cp "$_src/desktop/appvol.svg" "$root/usr/share/icons/hicolor/scalable/apps/appvol.svg"
    ln -sf /opt/appvol/bin/appvol-gui "$root/usr/bin/appvol-gui"
}

# fpm_package <deb|rpm> <name> <stage-function> [dependency ...]
fpm_package() {
    local fmt="$1" name="$2" stage="$3"
    shift 3
    if ! command -v fpm >/dev/null 2>&1; then
        echo "appvol-release: --$fmt needs fpm (gem install fpm, or ruby-fpm on Arch)" >&2
        exit 1
    fi
    local out arch
    if [ "$fmt" = deb ]; then
        arch=all
        out="dist/${name}_${version}-1_all.deb"
    else
        arch=noarch
        out="dist/${name}-${version}-1.noarch.rpm"
    fi
    local root="dist/pkgroot-$name"
    "$stage" "$root"
    local args=(-s dir -t "$fmt" -n "$name" -v "$version" --iteration 1 -a "$arch"
        --force --license MIT --category sound --url "$url" --maintainer "$maintainer"
        --description "$description" -C "$root" -p "$out")
    local dep
    for dep in "$@"; do
        args+=(--depends "$dep")
    done
    # fpm prints its errors on stdout, so do not hide it: an empty log would
    # make a failed build look like a missing package.
    if ! fpm "${args[@]}" usr opt; then
        echo "appvol-release: fpm failed to build $name" >&2
        exit 1
    fi
    rm -rf "$root"
    echo "appvol-release: package built: $out"
}

if [ "$with_deb" = yes ] || [ "$with_rpm" = yes ]; then
    prep_src
    if [ "$with_deb" = yes ]; then
        fpm_package deb appvol _stage_core \
            python3 python3-dbus python3-gi python3-pulsectl "plasma-workspace (>= 4:6~)"
        fpm_package deb appvol-gui _stage_gui \
            appvol python3-pyside6.qtwidgets python3-pyside6.qtqml \
            qml6-module-org-kde-kirigami qml6-module-org-kde-desktop \
            kf6-breeze-icon-theme
    fi
    if [ "$with_rpm" = yes ]; then
        fpm_package rpm appvol _stage_core \
            python3 python3-dbus python3-gobject python3-pulsectl "plasma-workspace >= 6"
        fpm_package rpm appvol-gui _stage_gui \
            appvol python3-pyside6 kf6-kirigami kf6-qqc2-desktop-style \
            breeze-icon-theme
    fi
    rm -rf "$_src"
fi

echo
echo "appvol: release $version"
echo "        dist/$archive  ($(du -h "dist/$archive" | cut -f1), sha256 ${sum:0:16}...)"
[ -n "$built" ] && echo "$built"
true
echo "        install:  (cd packaging && makepkg -si)   or   sudo pacman -U dist/*.pkg.tar.*"
echo "        or:       ./install.sh --service          (per-user, no root)"
[ "$with_deb" = yes ] && echo "        or:       sudo dpkg -i dist/appvol_${version}-1_all.deb dist/appvol-gui_${version}-1_all.deb"
[ "$with_rpm" = yes ] && echo "        or:       sudo rpm -i dist/appvol-${version}-1.noarch.rpm dist/appvol-gui-${version}-1.noarch.rpm"
if [ -d .git ]; then
    if git rev-parse -q --verify "refs/tags/v$version" >/dev/null; then
        echo "        git tag v$version is in place"
    else
        echo "        HEAD is not tagged yet:  git tag -a v$version -m \"appvol $version\""
    fi
fi
